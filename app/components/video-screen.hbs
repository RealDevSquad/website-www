<video
  data-test-video
  class="video-screen
    {{if this.liveService.isScreenShareOn '' 'video-screen--fill'}}"
  controls
  src={{@src}}
  type="video/mp4"
  autoplay
  muted
  playsinline
  loop
  {{create-global-ref "videoEl"}}
  {{picture-in-picture-events
    this.registerPictureInPictureListeners
    this.removePictureInPictureListeners
  }}
></video>